<%# hx-boost: each link fetches its page with htmx and swaps the <body>,
    so the browser never does a full page load, but the URL and the
    Back button still work. %>
<nav class="tabs" aria-label="Sections of the app" hx-boost="true" data-turbo="false">
  <table>
    <tr>
      <% { "courses" => "Courses", "sections" => "Sections", "students" => "Students" }.each do |tab, label| %>
        <td>
          <%# Select by controller, not URL, so "/" and "/students/3" pick the right tab %>
          <%= link_to label, { controller: tab, action: "index" },
                aria: { current: (controller_name == tab ? "page" : nil) } %>
        </td>
      <% end %>
    </tr>
  </table>
</nav>
